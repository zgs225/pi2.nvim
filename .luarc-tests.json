{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "LuaJIT"
    },
    "workspace": {
        "checkThirdParty": false,
        "ignoreSubmodules": true,
        "ignoreDir": [".git", ".github", ".gitea"],
        "library": ["${3rd}/luv/library"]
    },
    "diagnostics": {
        "globals": ["vim", "it", "describe", "before_each", "after_each", "pending"],
        "disable": [
            "inject-field",
            "undefined-doc-name",
            "undefined-field",
            "need-check-nil",
            "param-type-mismatch",
            "duplicate-set-field",
            "missing-parameter",
            "missing-return",
            "return-type-mismatch",
            "redundant-parameter"
        ]
    },
    "telemetry": {
        "enable": false
    }
}
